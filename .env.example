# Copy to .env. Defaults work for local simulation with zero external services.
DATABASE_URL=sqlite:///./data/sofa.db
# DATABASE_URL=postgresql+psycopg://sofa:sofa@localhost:5432/sofa
REDIS_URL=
PUBLIC_BASE_URL=http://localhost:8000

# Africa's Talking (empty key = SMS/voice calls are logged, not sent)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SANDBOX=true
AT_CALLBACK_SECRET=change-me-long-random
SMS_SENDER_ID=

# Paystack (empty key = mock virtual accounts)
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=test-bank

# Languages callers can use. The pilot is English + Yoruba. Add ha, ig only after translations and an ASR test.
ENABLED_LANGUAGES=en,yo
DUAL_ASR=true            # every enabled speech model hears every turn (code-mixing); needs both loaded on the GPU host

# GPU inference. inprocess://mock = built-in mocks (no server needed)
ASR_URL=inprocess://mock
LLM_URL=inprocess://mock
TTS_URL=inprocess://mock
LLM_MODEL=NCAIR1/N-ATLaS
LLM_STRUCTURED_MODE=modern   # legacy only for vLLM < 0.12
GPU_API_KEY=                 # same value on the GPU host; required when it is reachable from the internet
HF_TOKEN=

ADMIN_TOKEN=change-me
QUIET_HOURS=21:00-07:00
OUTBOUND_CALLS_ENABLED=true   # status calls to customers (payment, dispatch, delivery); NGN 15-20 a minute
SCHEDULER_ENABLED=true   # daily merchant report at each merchant's report time (default 19:00 Lagos)
TEST_CALLER_NUMBERS=+2348000000001

# The number callers dial to reach SOFA itself (the personal assistant) rather than a shop. Empty = off.
GATEWAY_NUMBER=

# Information search (Google Programmable Search). With no keys a small built-in set of facts answers, for demos and tests.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Passwords for the web consoles. Use long random ones (python -c "import secrets; print(secrets.token_urlsafe(18))"). Left unset they fall back to demo passwords.
ADMIN_TOKEN=
PROVIDER_TOKEN=
VENDOR_TOKEN=
# Where anything SOFA emails to its owner goes (nothing is emailed yet).
ADMIN_EMAIL=
